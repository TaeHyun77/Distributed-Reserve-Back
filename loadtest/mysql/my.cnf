[mysqld]
# --- 동시성/커넥션 ---
# Hikari 풀(baseline 30) 대비 충분히 크게 두어, DB 커넥션 한계가 1차 병목이 되지 않게 한다.
# ( 병목이 풀(30)인지 DB 인지 분리해서 보기 위함 )
max_connections=300

# --- 관측: 슬로우 쿼리 로그 ---
slow_query_log=1
slow_query_log_file=/var/lib/mysql/slow.log
long_query_time=0.5
log_queries_not_using_indexes=0

# --- 관측: 락/데드락 ---
innodb_print_all_deadlocks=1
performance_schema=ON

# --- InnoDB ( mem_limit 2.5g 컨테이너 기준 ) ---
innodb_buffer_pool_size=1280M
# loadtest baseline=2 ( Mac Docker 의 fsync 가상화 노이즈 제거 — 커밋당 fsync 대신 ~1초당 1회 ).
# flush 는 튜닝 레버: 내구성(운영과 동일 의미) 비교가 필요하면 1 로 두고 A/B. 프로덕션 Linux(실 SSD)는 1 권장.
innodb_flush_log_at_trx_commit=2
